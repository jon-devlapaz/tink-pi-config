{
  "name": "tink-pi-config",
  "private": true,
  "type": "module",
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0"
  },
  "overrides": {
    "minimatch": "^11.0.3",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "prettier": "^3.9.5",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "verify:updates": "node verification/verify-updates.mjs",
    "format": "prettier --write \"verification/*.{mjs,ts}\" \"*.json\"",
    "format:check": "prettier --check \"verification/*.{mjs,ts}\" \"*.json\"",
    "test": "node --test verification/*.test.mjs"
  }
