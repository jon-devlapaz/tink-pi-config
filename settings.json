{
  "theme": "github-dark-default",
  "quietStartup": true,
  "defaultProvider": "freellmapi",
  "defaultModel": "fusion",
  "defaultThinkingLevel": "medium",
  "enabledModels": [
    "meta/muse-spark-1.3-contributor",
    "openai-codex/gpt-6-sol",
    "freellmapi/fusion",
    "freellmapi/auto:fast",
    "freellmapi/auto:smart",
    "freellmapi/auto:reliable",
    "antigravity/gemini-3.8-flash",
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6-luna",
    "antigravity/claude-opus-4-6",
    "antigravity/claude-sonnet-4-6",
    "openai/gpt-6.1-sol",
    "openai/gpt-6-sol",
    "openai/gpt-6-luna",
    "openai/gpt-6-astra"
  ],
  "modelThinkingLevels": {
    "freellmapi/auto:fast": "off",
    "freellmapi/fusion": "off",
    "antigravity/gemini-3.8-flash": "medium",
    "meta/muse-spark-1.3-contributor": "max"
  },
  "compaction": {
    "enabled": false
  },
  "steeringMode": "all",
  "followUpMode": "all",
  "hideThinkingBlock": true,
  "retry": {
    "provider": {
      "timeoutMs": 120000
    }
  },
  "externalEditor": "code --wait",
  "defaultProjectTrust": "ask",
  "packages": [
    "npm:pi-blackhole",
    "git:github.com/earendil-works/pi-review",
    "npm:pi-typesafe",
    "npm:@andrewjacop/pi-herdr",
    "npm:pi-antigravity",
    "npm:pi-mcp-adapter",
    "git:github.com/helloHupc/pi-git-commands",
    "npm:@earendil-works/pi-voice",
    "git:github.com/McCune1224/pi-pstack",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-subagents",
    "npm:pi-provider-fallback"
  ]
}
