{
  "theme": "system",
  "quietStartup": true,
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "medium",
  "modelThinkingLevels": {
    "freellmapi/auto:fast": "off",
    "freellmapi/fusion": "off",
    "openai/gpt-6-luna": "medium",
    "openai/gpt-6.1-sol": "high",
    "openai/gpt-6-astra": "max"
  },
  "compaction": {
    "enabled": true
  },
  "steeringMode": "all",
  "followUpMode": "all",
  "hideThinkingBlock": false,
  "retry": {
    "provider": {
      "timeoutMs": 120000
    }
  },
  "defaultProjectTrust": "ask",
  "defaultTools": [
    "+grep",
    "+find",
    "+ls"
  ],
  "packages": [
    "git:github.com/earendil-works/pi-review",
    "npm:pi-typesafe",
    "npm:@earendil-works/pi-voice",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-todo",
    "npm:@jetserge/next-prompt",
    {
      "source": "npm:pi-web-access"
    },
    "git:github.com/jon-devlapaz/pi-copy-all",
    "git:github.com/jon-devlapaz/pi-git-info"
  ],
  "extensions": [
    "+builtin:mcp",
    "-extensions/model-info/index.ts",
    "-extensions/herdr-commands/index.ts",
    "-extensions/herdr-naming/index.ts",
    "-extensions/herdr-agent-state.ts",
    "-extensions/workflows/index.ts",
    "-extensions/background-terminals/index.ts",
    "-extensions/statusline/index.ts",
    "-extensions/ui-customization/index.ts",
    "-extensions/session-rotation/index.ts",
    "-extensions/todo-replay/index.ts",
    "-extensions/file-search/index.ts",
    "-extensions/copy-all/index.ts",
    "-extensions/git-info/index.ts"
  ],
  "showHardwareCursor": true,
  "terminal": {
    "showTerminalProgress": true
  },
  "markdown": {
    "mermaid": "streaming"
  },
  "showCacheMissNotices": true,
  "tuiMode": "fullscreen",
  "fullscreenExitOutput": "transcript"
}
