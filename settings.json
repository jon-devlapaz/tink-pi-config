{
  "theme": "github-dark-default",
  "quietStartup": true,
  "defaultProvider": "openai",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "medium",
  "modelThinkingLevels": {
    "freellmapi/auto:fast": "off",
    "freellmapi/fusion": "off",
    "openai/gpt-6-luna": "medium",
    "openai/gpt-6.1-sol": "high",
    "openai/gpt-6-astra": "max"
  },
  "compaction": {
    "enabled": false
  },
  "steeringMode": "all",
  "followUpMode": "all",
  "hideThinkingBlock": false,
  "retry": {
    "provider": {
      "timeoutMs": 120000
    }
  },
  "externalEditor": "code --wait",
  "defaultProjectTrust": "always",
  "packages": [
    "npm:pi-blackhole",
    "git:github.com/earendil-works/pi-review",
    "npm:pi-typesafe",
    "npm:@andrewjacop/pi-herdr",
    {
      "source": "npm:pi-mcp-adapter",
      "extensions": []
    },
    "git:github.com/helloHupc/pi-git-commands",
    "npm:@earendil-works/pi-voice",
    "git:github.com/McCune1224/pi-pstack",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-subagents"
  ],
  "extensions": [
    "+builtin:mcp"
  ],
  "subagents": {
    "defaultThinking": "high",
    "agentOverrides": {
      "scout": {
        "model": "openai/gpt-6-luna"
      },
      "delegate": {
        "model": "openai/gpt-6-luna"
      }
    }
  },
  "showHardwareCursor": true,
  "terminal": {
    "showTerminalProgress": true
  },
  "markdown": {
    "mermaid": "streaming"
  },
  "showCacheMissNotices": true,
  "tuiMode": "fullscreen",
  "fullscreenExitOutput": "transcript"
}
