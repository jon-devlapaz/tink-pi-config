{
  "providers": {
    "openai": {
      "modelOverrides": {
        "gpt-6-luna": {
          "name": "Cheap - GPT-6 Luna"
        },
        "gpt-6.1-sol": {
          "name": "Daily - GPT-6.1 Sol"
        },
        "gpt-6-astra": {
          "name": "Smart - GPT-6 Astra"
        }
      }
    },
    "typesafe": {
      "baseUrl": "https://api.typesafe.ai",
      "api": "typesafe-decisions",
      "apiKey": "$TYPESAFE_API_KEY",
      "models": [
        {
          "id": "jev-latest",
          "name": "Jev",
          "input": ["text"],
          "contextWindow": 64000,
          "cost": {
            "input": 0.042,
            "output": 0,
            "cacheRead": 0,
            "cacheWrite": 0
          }
        }
      ]
    },
    "freellmapi": {
      "baseUrl": "http://100.79.25.11:3001/v1",
      "api": "openai-completions",
      "apiKey": "$FREELLMAPI_API_KEY",
      "compat": {
        "supportsDeveloperRole": true,
        "supportsReasoningEffort": true,
        "supportsUsageInStreaming": true,
        "supportsFinishReason": true,
        "supportsStrictMode": false,
        "maxTokensField": "max_tokens",
        "thinkingFormat": "openai",
        "sendSessionAffinityHeaders": true,
        "sessionAffinityFormat": "openrouter"
      },
      "models": [
        {
          "id": "fusion",
          "name": "FreeLLMAPI Fusion",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 1048576,
          "maxTokens": 32768,
          "cost": {
            "input": 0,
            "output": 0,
            "cacheRead": 0,
            "cacheWrite": 0
          }
        },
        {
          "id": "auto:smart",
          "name": "FreeLLMAPI Smart",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 128000,
          "maxTokens": 16384,
          "cost": {
            "input": 0,
