#!/bin/sh
set -eu

case "${1-}" in
  -h|--help)
    printf '%s\n' 'Usage: pi-doctor' 'Verify Pi version pins, local extensions, types, tests, runtime/TUI behavior, and dependency security.' 'Defaults to the global Pi on PATH, excluding npm-local SDK binaries. PI_VERIFY_CLI selects an explicit executable.' 'Uses isolated synthetic model fixtures; npm security audits contact the registry.'
    exit 0
    ;;
esac
if [ "$#" -ne 0 ]; then
  printf '%s\n' 'Usage: pi-doctor' >&2
  exit 2
fi

script=$0
while [ -L "$script" ]; do
  directory=$(CDPATH= cd -P "$(dirname "$script")" && pwd)
  target=$(readlink "$script")
  case "$target" in
    /*) script=$target ;;
    *) script=$directory/$target ;;
  esac
done
repository=$(CDPATH= cd -P "$(dirname "$script")/.." && pwd)
PI_VERIFY_CLI=$(node "$repository/verification/resolve-cli.mjs")
export PI_VERIFY_CLI
exec npm --prefix "$repository" run verify:updates
